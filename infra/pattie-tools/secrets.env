# 1Password secret references, resolved by `op run` when the container starts. No secrets here.
# Vault "Pattie", one item per service. Field names must match the items in 1Password.
TILION_API_KEY=op://Pattie/Tilion/credential
# Uncomment when the Privacy.com cards exist (ARCHITECTURE.md, "Purchases"):
# PRIVACY_API_KEY=op://Pattie/Privacy.com/credential
# PATTIE_CARD_TOKEN_AMAZON=op://Pattie/Privacy.com/amazon card token
# PATTIE_CARD_TOKEN_DOORDASH=op://Pattie/Privacy.com/doordash card token

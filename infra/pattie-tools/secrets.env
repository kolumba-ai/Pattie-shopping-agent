# 1Password secret references, resolved by `op run` when the container starts. No secrets here.
# Vault "Engineering" (the one the "Pattie" service account can read), one item per service.
TILION_API_KEY=op://Engineering/Tilion/credential
# Uncomment when the Privacy.com cards exist (ARCHITECTURE.md, "Purchases"):
# PRIVACY_API_KEY=op://Engineering/Privacy.com/credential
# PATTIE_CARD_TOKEN_AMAZON=op://Engineering/Privacy.com/amazon card token
# PATTIE_CARD_TOKEN_DOORDASH=op://Engineering/Privacy.com/doordash card token

# 1Password secret references for the watcher, resolved by `op run` at start. No secrets here.
# Items live in the "Engineering" vault, which the "Pattie" service account can read.
ANTHROPIC_API_KEY=op://Engineering/ANTHROPIC_API_KEY/credential
TILION_API_KEY=op://Engineering/Tilion/credential
# Optional, once those items exist:
# AMPLITUDE_API_KEY=op://Engineering/Amplitude/credential
